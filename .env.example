# Root .env.example
NODE_ENV=production
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:pass@rds-endpoint:5432/mysarthi
DATABASE_READ_URL=postgresql://user:pass@rds-read-endpoint:5432/mysarthi

# Redis
REDIS_URL=redis://elasticache-endpoint:6379

# Kafka
KAFKA_BROKERS=kafka1:9092,kafka2:9092

# JWT
JWT_SECRET=<256-bit secret>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET=mysarthi-assets
AWS_SES_FROM=noreply@mysarthi.in

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=xxx

# Firebase (FCM)
FIREBASE_SERVICE_ACCOUNT=<base64 JSON>

# Google Maps
GOOGLE_MAPS_API_KEY=xxx

# Sentry
SENTRY_DSN=https://xxx@sentry.io/xxx

# AI Service
AI_SERVICE_URL=http://ai-service:8000
